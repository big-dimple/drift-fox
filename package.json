{
  "name": "drift-fox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landscape-first cel-shaded arcade snowfield drifter: an arctic fox grips, drifts, and leaps ravines.",
  "scripts": {
