    "verify:smoke": "node harness/screenshot.mjs --verify-smoke"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.1"
  }
}
